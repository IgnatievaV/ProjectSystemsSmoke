<Project Sdk="Microsoft.NET.Sdk">

  <!-- xUnit v3 on Microsoft.Testing.Platform (created with "dotnet new xunit" using the xunit-version v3 option).
       The MTP runner for `dotnet test` is selected in global.json ("test": { "runner": ... }). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="IfDifferent" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <Import Project="..\..\src\Smoke.Shared\Smoke.Shared.projitems" Label="Shared" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\Smoke.Library\Smoke.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
