<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- F# compile order matters: move files up/down in Solution Explorer and check the order here. -->
  <ItemGroup>
    <Compile Include="Shapes.fs" />
    <Compile Include="Library.fs" />
    <Compile Include="FileToSearch.fs" />
  </ItemGroup>

  <!-- Non-code files must be listed explicitly in F# projects (no default globs). -->
  <ItemGroup>
    <None Include="Actions\Copy\CopyMe.css" />
    <None Include="Actions\Copy\CopyMe.html" />
    <None Include="Actions\Copy\CopyMe.js" />
    <None Include="Actions\Copy\CopyMe.min.js" />
    <None Include="Actions\Rename\RenameMe.css" />
    <None Include="Actions\Rename\RenameMe.html" />
    <None Include="Actions\Rename\RenameMe.js" />
    <None Include="Actions\Rename\RenameMe.min.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smoke.Library\Smoke.Library.csproj" />
  </ItemGroup>

</Project>
