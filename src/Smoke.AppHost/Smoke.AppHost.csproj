<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.1" />

  <!-- Aspire AppHost orchestrating Smoke.Web and Smoke.Blazor. .NET 11: dotnet watch integrates with Aspire app hosts. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>project-systems-smoke-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smoke.Web\Smoke.Web.csproj" />
    <ProjectReference Include="..\Smoke.Blazor\Smoke.Blazor.csproj" />
  </ItemGroup>

</Project>
